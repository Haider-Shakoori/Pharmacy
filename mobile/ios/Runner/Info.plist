<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>Darmaltoon</string>
    <key>CFBundleName</key><string>businessos_pharmacy</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleShortVersionString</key><string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleVersion</key><string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>NSCameraUsageDescription</key><string>Darmaltoon uses the camera to scan medicine barcodes and QR codes.</string>
    <key>NSPhotoLibraryUsageDescription</key><string>Darmaltoon uses selected photos for medicine and inventory records.</string>
    <key>NSPhotoLibraryAddUsageDescription</key><string>Darmaltoon saves selected pharmacy images when requested.</string>
    <key>NSLocalNetworkUsageDescription</key><string>Darmaltoon connects to your pharmacy server on the local network.</string>
    <key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <key>UILaunchStoryboardName</key><string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key><string>Main</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
</dict>
</plist>
