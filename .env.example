APP_NAME="BusinessOS Pharmacy"
APP_ENV=local
APP_TIMEZONE=Asia/Kabul
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=central

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PHARMACY_DEPLOYMENT_HOST=pharmacy.businessos.af
PHARMACY_CURRENCY=AFN

PLATFORM_ADMIN_NAME="Platform Administrator"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

LICENSE_SIGNING_PRIVATE_KEY_B64=
LICENSE_SIGNING_PUBLIC_KEY_B64=

PHARMACY_PLATFORM_DOMAIN=pharmacy.businessos.af

# Central SaaS database. Each pharmacy gets a separate tenant database.
CENTRAL_DB_CONNECTION=sqlite
CENTRAL_DB_DATABASE=database/database.sqlite
TENANCY_DB_PROVISIONER=local

# cPanel provisioning (production). Use a scoped cPanel API token, never a password.
CPANEL_API_HOST=https://cpanel.example.com:2083
CPANEL_USERNAME=
CPANEL_API_TOKEN=
CPANEL_DATABASE_PREFIX=
CPANEL_DATABASE_USER=
CPANEL_API_TIMEOUT_SECONDS=15
CPANEL_VERIFY_TLS=true
TENANT_READINESS_TIMEOUT_SECONDS=8


# Database backup and recovery. Keep BACKUP_ROOT outside the public web root.
BACKUP_ROOT=
BACKUP_RETENTION_COUNT=14
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_TIME=02:15
BACKUP_PRUNE_TIME=03:15
BACKUP_PROCESS_TIMEOUT_SECONDS=600
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_MYSQL_BINARY=mysql

# Signed Windows desktop update manifests are stored outside the public web root.
DESKTOP_UPDATE_MANIFEST_DIR=